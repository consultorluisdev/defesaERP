# Copie para .env e preencha com valores reais (nunca commite o .env)
POSTGRES_PASSWORD=mude-esta-senha
JWT_KEY=gerar-uma-chave-com-pelo-menos-32-caracteres

# Porta do Postgres exposta apenas em localhost (compose de producao)
POSTGRES_PORT=5435
# Porta do Postgres no compose de desenvolvimento
POSTGRES_PORT_DEV=5436

# Origens permitidas no CORS do backend (separadas por ;)
CORS_ALLOWED_ORIGINS=http://localhost:3000;http://127.0.0.1:3000

# Usada apenas pelo compose de desenvolvimento (Vite roda fora do Nginx)
VITE_API_URL=http://localhost:8080/api
